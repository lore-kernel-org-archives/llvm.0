   121	/**
   122	 * accel_minor_replace() - Replace minor pointer in accel idr.
   123	 * @minor: Pointer to the new minor.
   124	 * @index: The IDR index to replace.
   125	 *
   126	 * This function access the accel minor idr structure and replaces the pointer
   127	 * that is associated with an existing id. Because the minor pointer can be
   128	 * NULL, we need to explicitely pass the index.
   129	 *
   130	 * Context: The function takes the accel_minor_lock as it changes the idr
   131	 */
 > 132	void accel_minor_replace(struct drm_minor *minor, int index)
   133	{
   134		unsigned long flags;
   135	
   136		spin_lock_irqsave(&accel_minor_lock, flags);
   137		idr_replace(&accel_minors_idr, minor, index);
   138		spin_unlock_irqrestore(&accel_minor_lock, flags);
   139	}
   140	
   141	/*
   142	 * Looks up the given minor-ID and returns the respective DRM-minor object. The
   143	 * refence-count of the underlying device is increased so you must release this
   144	 * object with accel_minor_release().
   145	 *
   146	 * The object can be only a drm_minor that represents an accel device.
   147	 *
   148	 * As long as you hold this minor, it is guaranteed that the object and the
   149	 * minor->dev pointer will stay valid! However, the device may get unplugged and
   150	 * unregistered while you hold the minor.
   151	 */
   152	static struct drm_minor *accel_minor_acquire(unsigned int minor_id)
   153	{
   154		struct drm_minor *minor;
   155		unsigned long flags;
   156	
   157		spin_lock_irqsave(&accel_minor_lock, flags);
   158		minor = idr_find(&accel_minors_idr, minor_id);
   159		if (minor)
   160			drm_dev_get(minor->dev);
   161		spin_unlock_irqrestore(&accel_minor_lock, flags);
   162	
   163		if (!minor) {
   164			return ERR_PTR(-ENODEV);
   165		} else if (drm_dev_is_unplugged(minor->dev)) {
   166			drm_dev_put(minor->dev);
   167			return ERR_PTR(-ENODEV);
   168		}
   169	
   170		return minor;
   171	}
   172	
   173	static void accel_minor_release(struct drm_minor *minor)
   174	{
   175		drm_dev_put(minor->dev);
   176	}
   177	
   178	/**
   179	 * accel_open - open method for ACCEL file
   180	 * @inode: device inode
   181	 * @filp: file pointer.
   182	 *
   183	 * This function must be used by drivers as their &file_operations.open method.
   184	 * It looks up the correct ACCEL device and instantiates all the per-file
   185	 * resources for it. It also calls the &drm_driver.open driver callback.
   186	 *
   187	 * Return: 0 on success or negative errno value on failure.
   188	 */
 > 189	int accel_open(struct inode *inode, struct file *filp)
   190	{
   191		struct drm_device *dev;
   192		struct drm_minor *minor;
   193		int retcode;
   194	
   195		minor = accel_minor_acquire(iminor(inode));
   196		if (IS_ERR(minor))
   197			return PTR_ERR(minor);
   198	
   199		dev = minor->dev;
   200	
   201		atomic_fetch_inc(&dev->open_count);
